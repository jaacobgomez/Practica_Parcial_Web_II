### Register
POST {{baseUrl}}/api/user/register HTTP/1.1
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "12345678"
}

### Validation
PUT {{baseUrl}}/api/user/validation HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "312596"
}

### Login
POST {{baseUrl}}/api/user/login HTTP/1.1
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "12345678"
}

### Personal data
PUT {{baseUrl}}/api/user/register HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Jacob",
  "lastName": "Gomez Rodenas",
  "nif": "55282604Q",
  "address": {
    "street": "Calle Mayor",
    "number": "10",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### Company
PATCH {{baseUrl}}/api/user/company HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Indra Sistemas",
  "cif": "B12345670",
  "address": {
    "street": "Avenida Central",
    "number": "25",
    "postal": "28002",
    "city": "Madrid",
    "province": "Madrid"
  },
  "isFreelance": false
}

### Current user
GET {{baseUrl}}/api/user HTTP/1.1
Authorization: Bearer {{token}}

### Refresh token
POST {{baseUrl}}/api/user/refresh HTTP/1.1
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Logout
POST {{baseUrl}}/api/user/logout HTTP/1.1
Authorization: Bearer {{token}}

### Change password
PUT {{baseUrl}}/api/user/password HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "12345678",
  "newPassword": "123456789"
}

### Soft delete user
DELETE {{baseUrl}}/api/user?soft=true HTTP/1.1
Authorization: Bearer {{token}}

### Hard delete user
DELETE {{baseUrl}}/api/user HTTP/1.1
Authorization: Bearer {{token}}

### Invite user
POST {{baseUrl}}/api/user/invite HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "invite@test.com",
  "password": "12345678"
}

### Upload company logo
PATCH {{baseUrl}}/api/user/logo HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="logo"; filename="logo.png"
Content-Type: image/png

< ./logo.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Current user after logo
GET {{baseUrl}}/api/user HTTP/1.1
Authorization: Bearer {{token}}

### Create client
POST {{baseUrl}}/api/client HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Cliente Demo",
  "cif": "B11111111",
  "email": "cliente@demo.com",
  "phone": "600123123",
  "address": {
    "street": "Calle Cliente",
    "number": "12",
    "postal": "28010",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### List clients
GET {{baseUrl}}/api/client?page=1&limit=10&name=Cliente&sort=-createdAt HTTP/1.1
Authorization: Bearer {{token}}

### List clients filter by name
GET {{baseUrl}}/api/client?page=1&limit=10&name=Demo HTTP/1.1
Authorization: Bearer {{token}}

### Get client by id
GET {{baseUrl}}/api/client/{{clientId}} HTTP/1.1
Authorization: Bearer {{token}}

### Update client
PUT {{baseUrl}}/api/client/{{clientId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "phone": "699999999"
}

### Soft delete client
DELETE {{baseUrl}}/api/client/{{clientId}}?soft=true HTTP/1.1
Authorization: Bearer {{token}}

### Archived clients
GET {{baseUrl}}/api/client/archived HTTP/1.1
Authorization: Bearer {{token}}

### Restore client
PATCH {{baseUrl}}/api/client/{{clientId}}/restore HTTP/1.1
Authorization: Bearer {{token}}

### Hard delete client
DELETE {{baseUrl}}/api/client/{{clientId}} HTTP/1.1
Authorization: Bearer {{token}}

### Get client after hard delete
GET {{baseUrl}}/api/client/{{clientId}} HTTP/1.1
Authorization: Bearer {{token}}

### Create project
POST {{baseUrl}}/api/project HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "client": "{{clientId}}",
  "name": "Reforma Cocina",
  "projectCode": "PRJ-001",
  "address": {
    "street": "Calle Obra",
    "number": "7",
    "postal": "28020",
    "city": "Madrid",
    "province": "Madrid"
  },
  "email": "obra@demo.com",
  "notes": "Proyecto inicial",
  "active": true
}

### List projects
GET {{baseUrl}}/api/project?page=1&limit=10&name=Reforma&sort=-createdAt HTTP/1.1
Authorization: Bearer {{token}}

### List projects by client
GET {{baseUrl}}/api/project?page=1&limit=10&client={{clientId}} HTTP/1.1
Authorization: Bearer {{token}}

### Get project by id
GET {{baseUrl}}/api/project/{{projectId}} HTTP/1.1
Authorization: Bearer {{token}}

### Update project
PUT {{baseUrl}}/api/project/{{projectId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "notes": "Proyecto actualizado",
  "active": false
}

### Soft delete project
DELETE {{baseUrl}}/api/project/{{projectId}}?soft=true HTTP/1.1
Authorization: Bearer {{token}}

### Archived projects
GET {{baseUrl}}/api/project/archived HTTP/1.1
Authorization: Bearer {{token}}

### Restore project
PATCH {{baseUrl}}/api/project/{{projectId}}/restore HTTP/1.1
Authorization: Bearer {{token}}

### Hard delete project
DELETE {{baseUrl}}/api/project/{{projectId}} HTTP/1.1
Authorization: Bearer {{token}}